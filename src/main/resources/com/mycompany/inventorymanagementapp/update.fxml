<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" prefHeight="470.0" prefWidth="449.0" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.inventorymanagementapp.UpdateController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Enter the ID to update a product" />
      <TextField fx:id="idField" prefHeight="26.0" prefWidth="219.0" promptText="Enter ID of the Product:" />
      <Button mnemonicParsing="false" onAction="#handleShowProduct" text="Show Product" />
      <ListView fx:id="productListView" prefHeight="30.0" prefWidth="236.0" />
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Quantity" />
      <TextField fx:id="quantityField" promptText="Enter the new quantity" />
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Price (for each)" />
      <TextField fx:id="priceField" promptText="Enter the price:" />
      <Button mnemonicParsing="false" onAction="#handleUpdateProduct" text="Update Product" />
      <Button mnemonicParsing="false" onAction="#switchToMenu" text="Main Menu" />
   </children>
</VBox>
