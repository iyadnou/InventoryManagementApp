<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" prefHeight="432.0" prefWidth="509.0" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.inventorymanagementapp.CreateController">
   <children>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Name of The Product" />
      <TextField fx:id="nameField" prefHeight="26.0" prefWidth="319.0" promptText="Enter Name:" />
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Quantity" />
      <TextField fx:id="quantityField" promptText="Enter Quantity:" />
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Price " />
      <TextField fx:id="priceField" promptText="Enter Price:" />
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Supplier" />
      <TextField fx:id="supplierField" promptText="Enter Supplier:" />
      <Button mnemonicParsing="false" onAction="#handleCreateProduct" text="Create" />
      <Button mnemonicParsing="false" onAction="#switchToMenu" text="Main Menu" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
