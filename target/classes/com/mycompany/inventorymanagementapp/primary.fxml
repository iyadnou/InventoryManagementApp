<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="261.0" prefWidth="227.0" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.inventorymanagementapp.PrimaryController">
   <children>
      <Button mnemonicParsing="false" onAction="#switchToCreate" text="Add Products" />
      <Button mnemonicParsing="false" onAction="#switchToUpdate" text="Update Products" />
      <Button mnemonicParsing="false" onAction="#switchToDelete" text="Delete Products" />
      <Button mnemonicParsing="false" onAction="#switchToSearch" text="Search Products" />
      <Button onAction="#switchToTotal" text="Total Inventory Value" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
